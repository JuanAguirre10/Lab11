@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="state">
    <h1>No se pudo completar la operación</h1>
    <p>Ocurrió un problema al procesar la solicitud. Intente nuevamente en unos minutos.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small">Código de referencia: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-quiet" asp-controller="Eventos" asp-action="Index">Ir a eventos</a>
</div>
