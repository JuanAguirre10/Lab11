@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var mensaje = TempData["Mensaje"]?.ToString();
    var error = TempData["Error"]?.ToString();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Encuentros</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="container">
            <a class="brand" asp-controller="Eventos" asp-action="Index">
                <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="2.5" y="4.5" width="19" height="17" rx="3.5" fill="currentColor" />
                    <rect x="6.5" y="2" width="2.4" height="5.5" rx="1.2" fill="currentColor" />
                    <rect x="15.1" y="2" width="2.4" height="5.5" rx="1.2" fill="currentColor" />
                    <rect x="6" y="11" width="5" height="4" rx="1" fill="#fff" />
                </svg>
                <span>Encuentros</span>
            </a>
            <nav class="mainnav" aria-label="Menú principal">
                <a class="@(controlador == "Eventos" ? "active" : null)" asp-controller="Eventos" asp-action="Index">Eventos</a>
                <a class="@(controlador == "Asistentes" ? "active" : null)" asp-controller="Asistentes" asp-action="Index">Asistentes</a>
                <a class="@(controlador == "Inscripciones" ? "active" : null)" asp-controller="Inscripciones" asp-action="Index">Inscripciones</a>
            </nav>
        </div>
    </header>

    <main class="page">
        <div class="container">
            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <div class="alert flash fade show" role="status">
                    <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="currentColor" /><path d="M6 10.2l2.6 2.6L14 7.4" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    <span>@mensaje</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="alert flash flash-error fade show" role="alert">
                    <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="currentColor" /><path d="M10 5.5v5.5M10 14v.4" fill="none" stroke="#fff" stroke-width="1.9" stroke-linecap="round" /></svg>
                    <span>@error</span>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                </div>
            }
            @RenderBody()
        </div>
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
