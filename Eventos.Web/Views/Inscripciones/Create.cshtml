@model Inscripcion
@{
    ViewData["Title"] = "Nueva inscripción";
}

<a class="back" asp-action="Index">
    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5L5.5 8 10 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    Inscripciones
</a>

<div class="page-head">
    <div>
        <h1>Nueva inscripción</h1>
    </div>
</div>

<form asp-action="Create" method="post" class="panel form-panel" novalidate>
    <div class="panel-body">
        <div asp-validation-summary="ModelOnly"></div>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="EventoId" class="form-label">Evento</label>
                <select asp-for="EventoId" asp-items="ViewBag.Eventos" class="form-select">
                    <option value="0">Seleccione un evento</option>
                </select>
                <span asp-validation-for="EventoId"></span>
            </div>
            <div class="col-12">
                <label asp-for="AsistenteId" class="form-label">Asistente</label>
                <select asp-for="AsistenteId" asp-items="ViewBag.Asistentes" class="form-select">
                    <option value="0">Seleccione un asistente</option>
                </select>
                <span asp-validation-for="AsistenteId"></span>
                <div class="form-hint">¿No aparece en la lista? <a asp-controller="Asistentes" asp-action="Create">Registrar asistente</a></div>
            </div>
        </div>
    </div>
    <div class="form-actions">
        <a class="btn btn-quiet" asp-action="Index">Cancelar</a>
        <button type="submit" class="btn btn-primary">Inscribir</button>
    </div>
</form>
