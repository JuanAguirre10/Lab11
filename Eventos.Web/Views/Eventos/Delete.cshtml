@model Evento
@{
    ViewData["Title"] = "Eliminar evento";
    var confirmados = (int)ViewBag.Confirmados;
}

<a class="back" asp-action="Details" asp-route-id="@Model.Id">
    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5L5.5 8 10 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    Volver al evento
</a>

<div class="panel confirm-panel">
    <div class="panel-body">
        <h1>¿Eliminar este evento?</h1>
        <p class="lead-text">Dejará de aparecer en la lista de eventos y ya no recibirá inscripciones.</p>
        <dl class="facts">
            <dt>Evento</dt>
            <dd>@Model.Titulo</dd>
            <dt>Fecha</dt>
            <dd>@Formato.Fecha(Model.Fecha)</dd>
            <dt>Lugar</dt>
            <dd>@Model.Lugar · @Model.Modalidad</dd>
            <dt>Categoría</dt>
            <dd>@Model.Categoria.Nombre</dd>
        </dl>
        @if (confirmados == 1)
        {
            <div class="notice">Tiene 1 inscripción confirmada, que pasará a estado Cancelada.</div>
        }
        else if (confirmados > 1)
        {
            <div class="notice">Tiene @confirmados inscripciones confirmadas, que pasarán a estado Cancelada.</div>
        }
    </div>
    <form asp-action="Delete" method="post" class="form-actions">
        <input type="hidden" asp-for="Id" />
        <a class="btn btn-quiet" asp-action="Index">Cancelar</a>
        <button type="submit" class="btn btn-danger">Eliminar evento</button>
    </form>
</div>
