@model Evento

<div asp-validation-summary="ModelOnly"></div>
<div class="row g-3">
    <div class="col-12">
        <label asp-for="Titulo" class="form-label">Título</label>
        <input asp-for="Titulo" class="form-control" maxlength="100" autocomplete="off" />
        <span asp-validation-for="Titulo"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="CategoriaId" class="form-label">Categoría</label>
        <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select">
            <option value="0">Seleccione una categoría</option>
        </select>
        <span asp-validation-for="CategoriaId"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Fecha" class="form-label">Fecha y hora</label>
        <input asp-for="Fecha" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" class="form-control" />
        <span asp-validation-for="Fecha"></span>
    </div>
    <div class="col-12">
        <label asp-for="Lugar" class="form-label">Lugar</label>
        <input asp-for="Lugar" class="form-control" maxlength="100" placeholder="Ej. Auditorio principal, San Isidro" />
        <span asp-validation-for="Lugar"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Aforo" class="form-label">Aforo</label>
        <div class="input-group">
            <input asp-for="Aforo" type="number" min="1" max="5000" class="form-control" />
            <span class="input-group-text">personas</span>
        </div>
        <span asp-validation-for="Aforo"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Precio" class="form-label">Precio</label>
        <div class="input-group">
            <span class="input-group-text">S/</span>
            <input asp-for="Precio" type="number" min="0" step="0.01" class="form-control" />
        </div>
        <span asp-validation-for="Precio"></span>
        <div class="form-hint">Ingrese 0 si la entrada es libre.</div>
    </div>
</div>
